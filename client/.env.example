# Cloudinary 값은 이 파일이 아니라 server/.env에 넣습니다.
# CLOUDINARY_CLOUD_NAME
# CLOUDINARY_UPLOAD_PRESET

# 로컬 개발은 비워 두면 http://localhost:4000 을 씁니다.
# 배포(Vercel 무료)는 같은 주소의 /api 를 쓰므로 VITE_API_BASE 는 비웁니다.
# Vercel Environment Variables 에 넣을 이름:
# MONGO_URI
# JWT_SECRET
# CLOUDINARY_CLOUD_NAME
# CLOUDINARY_UPLOAD_PRESET
# CLIENT_ORIGIN=https://bomul-demo-vercel.vercel.app
