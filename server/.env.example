PORT=4000
# 배포된 사이트 주소. 여러 개면 쉼표로 구분합니다.
# Vercel 무료 테스트는 Environment Variables에도 같은 값을 넣습니다.
CLIENT_ORIGIN=https://bomul-demo-vercel.vercel.app
# 네이버 로그인 후 돌아갈 화면 주소
CLIENT_URL=http://localhost:5173
# MongoDB Atlas 주소. 값이 있으면 이 주소를 쓰고, 비어 있을 때만 로컬을 씁니다.
MONGO_ATLAS_URL=
# localhost는 IPv6(::1)로 해석돼 연결이 거부될 수 있으므로 127.0.0.1 사용
MONGODB_URI=mongodb://127.0.0.1:27017/coding-bomul
# 로그인 토큰 서명에 사용. 긴 무작위 문자열로 바꾸세요.
JWT_SECRET=replace-with-a-long-random-string
# 네이버 개발자센터(https://developers.naver.com/apps)에서 애플리케이션 등록 후 발급
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# Cloudinary 업로드 위젯. API Secret은 넣지 않습니다.
# 클라우드 이름: https://console.cloudinary.com/settings/account
# Upload preset: https://console.cloudinary.com/settings/upload 에서 Signing Mode를 Unsigned로 만든 이름
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
